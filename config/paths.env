CUR_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

export PROJECT_ROOT="$(cd -- "$CUR_DIR/.." &> /dev/null && pwd)"
export PATHS_DIR="$PROJECT_ROOT/config"
export BIN_DIR="$PROJECT_ROOT/bin"
export LIB_DIR="$PROJECT_ROOT/lib"
export WORK_DIR="$PROJECT_ROOT/work"
export ENV_DIR="$PROJECT_ROOT/env"